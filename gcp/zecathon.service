# Installed to /etc/systemd/system/zecathon.service by gcp/lib-vm.sh.
[Unit]
Description=ZECKATHON application stack (PostgreSQL + backend)
# Wants (not Requires): a Docker restart or upgrade must not stop this unit.
# The containers use `restart: unless-stopped`, so Docker brings them back itself.
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/zecathon/gcp
# Root-only secrets file (DB_PASSWORD, SECRET_KEY, GEMINI_API_KEY, ...).
EnvironmentFile=/etc/zecathon/zecathon.env
# Start the already-built images. Images are built only by deploy-vm.sh / update-vm.sh,
# so a restart never needs network access or free disk space for a rebuild.
ExecStart=/usr/bin/docker compose -f docker-compose.vm.yml up -d
# `stop`, not `down`: containers are kept, never deleted.
ExecStop=/usr/bin/docker compose -f docker-compose.vm.yml stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
