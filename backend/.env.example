DATABASE_URL=sqlite:///./hackathon.db
# For Docker Compose, use:
# DATABASE_URL=postgresql+psycopg2://zecathon:zecathon_secret@postgres:5432/zecathon
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AI_BACKEND_URL=http://localhost:5000
AI_BACKEND_TOKEN=
GEMINI_API_KEY=                    # Optional: enables real Gemini evaluations; if absent, deterministic fallback is used
GEMINI_MODEL=gemini-3.5-flash-lite   # Use gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.7-flash, or gemini-flash-latest
GITHUB_TOKEN=                    # Optional: increases GitHub API rate limits; public repos work without it
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=20971520
