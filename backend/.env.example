ENVIRONMENT=development          # "production" enables startup checks (strong SECRET_KEY, PostgreSQL) and refuses offline mock scores
DATABASE_URL=sqlite:///./hackathon.db
# For Docker Compose, use:
# DATABASE_URL=postgresql+psycopg2://zecathon:zecathon_secret@postgres:5432/zecathon
SECRET_KEY=change-me-in-production   # production: random, at least 32 characters (openssl rand -hex 48)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=                    # From aistudio.google.com/apikey (new keys start with AQ.). Enables real AI evaluations. Without it (and without AI_BACKEND_URL), development uses a flagged offline scorer; production refuses to score
GEMINI_MODEL=gemini-3.5-flash-lite   # Falls back to gemini-flash-lite-latest / gemini-3.8-flash / gemini-flash-latest only if this model is unavailable (404)
LLM_TIMEOUT_SECONDS=60            # Per LLM request; keep below the gunicorn/nginx timeouts (180s)
AI_BACKEND_URL=                   # Optional generic LLM endpoint; leave empty unless you run one
AI_BACKEND_TOKEN=
GITHUB_TOKEN=                    # Optional: increases GitHub API rate limits; public repos work without it
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=20971520
DISABLE_API_DOCS=false           # Set to true in production to disable /api/docs, /api/redoc, and /api/openapi.json
CORS_ORIGINS=*                   # Comma-separated origins, e.g. https://zecathon.example.com
